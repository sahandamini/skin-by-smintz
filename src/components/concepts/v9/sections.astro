---
import BookPill from '@/components/site/book-pill.astro'
import Closing from '@/components/site/closing.astro'
import Icon from '@/components/site/icon.astro'
import InstagramLink from '@/components/site/instagram-link.astro'
import Record from '@/components/site/record.astro'

import { expectations, galleryRows, pillars, sammyIntro, services } from '../v3/content'
import FaqList from '../v3/faq-list.astro'

import '../faq.css'
import './sections.css'

const room = galleryRows.flat().slice(0, 14)
---

<section id="services" class="v9-wall" aria-labelledby="v9-services-title">
	<div class="v9-tile v9-offer" data-reveal>
		<p class="gv-kicker">Services</p>
		<h2 id="v9-services-title">
			<span>$50 consult.</span> <span>$50 shop credit.</span>
		</h2>
		<p>After your consult, you get a $50 code for the shop, opening soon.</p>
		<BookPill />
	</div>
	{services.map((service, index) => (
		<article class:list={['v9-tile', 'v9-text', `v9-cover-${index + 1}`]} data-reveal>
			<span aria-hidden="true">{index + 1}</span>
			<h3>{service.name}</h3>
			<p class="v9-kind">{service.kind}</p>
			<p>{service.body}</p>
		</article>
	))}
</section>

<section class="v9-wall" aria-labelledby="v9-meet-title">
	<div class="v9-tile v9-meet-title" data-reveal>
		<Record />
		<h2 id="v9-meet-title">Meet Skin Groove</h2>
	</div>
	{pillars.map((pillar, index) => (
		<article class:list={['v9-tile', 'v9-text', 'v9-pillar', `v9-pillar-${index + 1}`]} data-reveal>
			<h3>{pillar.title}</h3>
			{pillar.body.map((paragraph) => (
				<p>{paragraph}</p>
			))}
		</article>
	))}
</section>

<section class="v9-wall" aria-labelledby="v9-sammy-title">
	<div class="v9-tile v9-hello" data-reveal>
		<p class="gv-kicker">The founder</p>
		<h2 id="v9-sammy-title">Hi, I’m Sammy!</h2>
	</div>
	<div aria-hidden="true" class="v9-tile v9-stripes is-side"></div>
	<div class="v9-tile v9-text v9-letter" data-reveal>
		{sammyIntro.map((paragraph) => (
			<p set:html={paragraph} />
		))}
		<div class="v9-letter-actions">
			<a class="gv-pill" href="/about">
				Meet the founder
				<Icon name="arrowRight" />
			</a>
			<InstagramLink />
		</div>
	</div>
</section>

<section class="v9-wall" aria-labelledby="v9-expect-title">
	<div class="v9-tile v9-expect-title" data-reveal>
		<h2 id="v9-expect-title">What you can expect</h2>
	</div>
	{expectations.map((item, index) => (
		<article class:list={['v9-tile', 'v9-text', 'v9-expect', `v9-expect-${index + 1}`]} data-reveal>
			<h3>{item.title}</h3>
			<p set:html={item.body} />
		</article>
	))}
</section>

<section class="v9-wall" aria-labelledby="v9-room-title">
	<div class="v9-tile v9-room-title" data-reveal>
		<h2 id="v9-room-title">The Groove Room</h2>
		<p>Warm light, soft shapes, and spaces that feel like an exhale.</p>
		<InstagramLink />
	</div>
	{room.map((image) => (
		<figure aria-hidden="true" class="v9-tile v9-photo">
			<img alt="" decoding="async" height="300" loading="lazy" src={`/images/groove/${image}.webp`} width="300" />
		</figure>
	))}
</section>

<section id="faq" class="v9-wall" aria-labelledby="v9-faq-title">
	<div class="v9-tile v9-faq" data-reveal>
		<h2 id="v9-faq-title">Before you book</h2>
		<FaqList />
	</div>
</section>

<div class="v9-gap"></div>

<Closing />
