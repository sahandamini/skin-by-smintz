---
import BookPill from '@/components/site/book-pill.astro'
import SiteNav from '@/components/site/site-nav.astro'

import './echo.css'
import './v12.css'
---

<header class="v12-poster">
	<SiteNav />
	<div class="v12-poster-copy">
		<h1>
			<span class="v12-eyebrow">Skin Groove · Virtual esthetics</span>
			<span class="v12-big v12-title">Find your skincare rhythm.</span>
		</h1>
		<p>
			Thoughtful, curated skincare guidance to help you understand your skin,
			simplify your routine, and finally find what works for you.
		</p>
		<BookPill />
	</div>
	<figure>
		<img
			alt="Sammy, the founder of Skin Groove, smiling in a black uniform"
			fetchpriority="high"
			height="1080"
			src="/images/sammy.webp"
			width="810"
		/>
	</figure>
	<div aria-hidden="true" class="v12-corner"></div>
</header>
