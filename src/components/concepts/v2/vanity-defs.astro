<!-- Glass and metal gradients for every vanity object on the page. -->
<svg aria-hidden="true" class="gv-vanity-defs">
	<defs>
		<linearGradient id="glass-amber">
			<stop offset="0" stop-color="var(--glass-amber-edge)"></stop>
			<stop offset="0.22" stop-color="var(--glass-amber-mid)"></stop>
			<stop offset="0.48" stop-color="var(--amber)"></stop>
			<stop offset="0.74" stop-color="var(--glass-amber-warm)"></stop>
			<stop offset="1" stop-color="var(--glass-amber-edge)"></stop>
		</linearGradient>
		<linearGradient id="glass-olive">
			<stop offset="0" stop-color="var(--glass-olive-edge)"></stop>
			<stop offset="0.3" stop-color="var(--avocado)"></stop>
			<stop offset="0.52" stop-color="var(--glass-olive-light)"></stop>
			<stop offset="0.76" stop-color="var(--avocado)"></stop>
			<stop offset="1" stop-color="var(--glass-olive-edge)"></stop>
		</linearGradient>
		<linearGradient id="glass-garnet">
			<stop offset="0" stop-color="var(--glass-garnet-edge)"></stop>
			<stop offset="0.36" stop-color="var(--garnet)"></stop>
			<stop offset="0.56" stop-color="var(--glass-garnet-light)"></stop>
			<stop offset="1" stop-color="var(--glass-garnet-edge)"></stop>
		</linearGradient>
		<linearGradient id="metal-brass">
			<stop offset="0" stop-color="var(--brass-dark)"></stop>
			<stop offset="0.45" stop-color="var(--brass-light)"></stop>
			<stop offset="1" stop-color="var(--brass-mid)"></stop>
		</linearGradient>
		<linearGradient id="lid-cream">
			<stop offset="0" stop-color="var(--lid-shade)"></stop>
			<stop offset="0.45" stop-color="var(--lid-light)"></stop>
			<stop offset="1" stop-color="var(--lid-edge)"></stop>
		</linearGradient>
		<linearGradient id="lava-fluid" x2="0" y2="1">
			<stop offset="0" stop-color="var(--apricot)"></stop>
			<stop offset="1" stop-color="var(--amber)"></stop>
		</linearGradient>
		<radialGradient cx="0.42" cy="0.32" id="dome-burnt" r="0.85">
			<stop offset="0" stop-color="var(--dome-light)"></stop>
			<stop offset="0.5" stop-color="var(--dome-mid)"></stop>
			<stop offset="1" stop-color="var(--dome-edge)"></stop>
		</radialGradient>
		<radialGradient id="lamp-glow">
			<stop offset="0" stop-color="var(--lamp-light)" stop-opacity="0.9"></stop>
			<stop offset="1" stop-color="var(--lamp-light)" stop-opacity="0"></stop>
		</radialGradient>
		<linearGradient id="mirror-face" x1="0" x2="1" y1="0" y2="1">
			<stop offset="0" stop-color="var(--lid-light)"></stop>
			<stop offset="0.5" stop-color="var(--mirror-mid)"></stop>
			<stop offset="1" stop-color="var(--apricot)"></stop>
		</linearGradient>
	</defs>
</svg>
