---
import BookPill from '@/components/site/book-pill.astro'
import Closing from '@/components/site/closing.astro'
import Icon from '@/components/site/icon.astro'
import InstagramLink from '@/components/site/instagram-link.astro'
import Record from '@/components/site/record.astro'

import { expectations, pillars, sammyIntro, services } from './content'
import FaqList from './faq-list.astro'
import GalleryRows from './gallery-rows.astro'
import VanityObject from './vanity-object.astro'

import './sections.css'
---

<section
	id="services"
	class="home-services"
	aria-labelledby="home-services-title"
>
	<div class="home-services-head" data-reveal>
		<p class="gv-kicker">Services</p>
		<h2 id="home-services-title">
			<span>$50 consult.</span> <span>$50 shop credit.</span>
		</h2>
		<p>After your consult, you get a $50 code for the shop, opening soon.</p>
	</div>
	<ol aria-label="Services" class="home-labels gv-rail">
		{services.map((service, index) => (
			<li>
				<VanityObject name={service.object} />
				<p class="home-label-number">No. {index + 1}</p>
				<h3>{service.name}</h3>
				<p class="home-label-kind">{service.kind}</p>
				<p>{service.body}</p>
			</li>
		))}
	</ol>
</section>

<section class="home-meet" aria-labelledby="home-meet-title">
	<div class="home-meet-inner">
		<div class="home-meet-head" data-reveal>
			<Record class="home-meet-record" />
			<h2 id="home-meet-title">Meet Skin Groove</h2>
		</div>
		<div
			aria-label="Meet Skin Groove"
			class="home-meet-list gv-rail"
			role="group"
		>
			{pillars.map((pillar) => (
				<article>
					<h3>{pillar.title}</h3>
					{pillar.body.map((paragraph) => (
						<p>{paragraph}</p>
					))}
				</article>
			))}
		</div>
	</div>
</section>

<section class="home-sammy" aria-labelledby="home-sammy-title">
	<div class="home-sammy-head" data-reveal>
		<figure class="home-sammy-photo">
			<img
				alt="Sammy, the founder of Skin Groove, smiling in a black uniform"
				decoding="async"
				height="1080"
				loading="lazy"
				src="/images/sammy.webp"
				width="810"
			/>
		</figure>
		<div>
			<p class="gv-kicker">The founder</p>
			<h2 id="home-sammy-title">Hi, I’m Sammy!</h2>
		</div>
	</div>
	<div class="home-sammy-copy" data-reveal>
		{sammyIntro.map((paragraph) => (
			<p set:html={paragraph} />
		))}
		<div class="home-sammy-actions">
			<a class="gv-pill" href="/about">
				Meet the founder
				<Icon name="arrowRight" />
			</a>
			<InstagramLink />
		</div>
	</div>
</section>

<section class="home-expect" aria-labelledby="home-expect-title">
	<div class="home-expect-inner">
		<h2 id="home-expect-title" data-reveal>
			What you can expect
		</h2>
		<ul class="home-expect-list">
			{expectations.map((item) => (
				<li data-reveal>
					<h3>{item.title}</h3>
					<p set:html={item.body} />
				</li>
			))}
		</ul>
		<div class="home-expect-cta" data-reveal>
			<BookPill />
		</div>
	</div>
</section>

<section class="home-room" aria-labelledby="home-room-title">
	<div class="home-room-head" data-reveal>
		<h2 id="home-room-title">The Groove Room</h2>
		<p>Warm light, soft shapes, and spaces that feel like an exhale.</p>
		<InstagramLink />
	</div>
	<GalleryRows />
</section>

<section id="faq" class="home-faq" aria-labelledby="home-faq-title">
	<figure class="home-faq-photo" data-reveal>
		<img
			alt="A row of glowing lava lamps"
			height="1277"
			loading="lazy"
			src="/images/groove/61.webp"
			width="1800"
		/>
	</figure>
	<div class="home-faq-copy" data-reveal>
		<h2 id="home-faq-title">Before you book</h2>
		<FaqList />
	</div>
</section>

<Closing />
