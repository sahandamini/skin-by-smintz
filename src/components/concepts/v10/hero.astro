---
import BookPill from '@/components/site/book-pill.astro'
import SiteNav from '@/components/site/site-nav.astro'

import './echo.css'
import './hero.css'
---

<header class="v10-hero">
	<SiteNav />
	<div aria-hidden="true" class="v10-sash"></div>
	<div class="v10-copy">
		<h1>
			<span class="v10-eyebrow">Skin Groove · Virtual esthetics</span>
			<span class="v10-title">Find your skincare</span>
			<span class="v10-rhythm v10-echo-big">rhythm.</span>
		</h1>
		<p>
			Thoughtful, curated skincare guidance to help you understand your skin,
			simplify your routine, and finally find what works for you.
		</p>
		<BookPill />
	</div>
	<figure class="v10-portrait">
		<img
			alt="Sammy, the founder of Skin Groove, smiling in a black uniform"
			fetchpriority="high"
			height="1080"
			src="/images/sammy.webp"
			width="810"
		/>
	</figure>
</header>
