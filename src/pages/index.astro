---
import Base from '@/layouts/base.astro'

const versions = [
	{ href: '/v1', name: 'V1 · Ripple', note: 'Wavy mirror, flat ripple bands, album sleeve' },
	{ href: '/v2', name: 'V2 · Vanity', note: 'Cream wall, sun lamp, drawn shelf' },
	{ href: '/v3', name: 'V3 · Flow', note: 'Stripe ribbon, big records, colour fields' },
	{ href: '/v4', name: 'V4 · The Lounge', note: 'Walk through the doorway, neon, photography' },
	{ href: '/v5', name: 'V5 · Wallpaper', note: 'Op-art wave wall, dancing letters, swatch book' },
	{ href: '/v6', name: 'V6 · Sunburst', note: 'Turning rays, rising sun portrait, flower power' },
	{ href: '/v7', name: 'V7 · The Track', note: 'One striped track runs through the whole page' },
	{ href: '/v8', name: 'V8 · Melt', note: 'Rising lava, dripping sections, wax blobs' },
	{ href: '/v9', name: 'V9 · Album Wall', note: 'The whole page is one grid of record covers' },
	{ href: '/v10', name: 'V10 · Echo', note: 'Outline-ring lettering and slanted 1976 stripes' },
	{ href: '/v11', name: 'V11 · Quiet Echo', note: 'Centered, calm, dark and cream, one stripe' },
	{ href: '/v12', name: 'V12 · Sticky Poster', note: 'One poster stays pinned while the content scrolls' },
	{ href: '/v13', name: 'V13 · Remix', note: 'V10 lettering, V1 mirror, V3 curves, kept simple' },
]
---

<Base>
	<main class="gv concept-hub">
		<h1>Skin Groove landing versions</h1>
		{versions.map((version) => (
			<a href={version.href}>
				<b>{version.name}</b>
				{version.note}
			</a>
		))}
	</main>
</Base>

<style is:global>
	.concept-hub {
		display: grid;
		gap: 0.75rem;
		width: min(100% - 3rem, 34rem);
		margin: 0 auto;
		padding-block: 3rem;
	}

	.concept-hub h1 {
		font: 400 2.25rem/1.05 var(--display);
	}

	.concept-hub a {
		display: grid;
		gap: 0.25rem;
		padding: 1.1rem 1.25rem;
		border-radius: 1rem;
		background: var(--chestnut);
		color: var(--cream);
	}

	.concept-hub b {
		color: var(--amber);
		font: 400 1.4rem/1.1 var(--display);
	}
</style>
